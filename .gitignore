# ---------------------------------------------------------------------------
# Secrets -- NEVER commit these.
# `.env` holds live provider keys (OpenRouter, Groq, Gemini, Cloudflare,
# Z.ai, NVIDIA, Cohere) and per-project `.env` files hold brokerage/EDGAR
# credentials.  `.env.example` IS tracked: it is the documented template.
# ---------------------------------------------------------------------------
.env
.env.*
!.env.example

# Backup copies of anything above.  `.env.bak` is the obvious one, and it is
# the trap this rule closes: the `.env` pattern above does NOT cover
# `.env.bak`, so a copy taken "just in case" sits in the tree looking harmless
# and is committable.  Checked before adding this, and confirmed that a copy
# placed *inside* an already-ignored directory (.shared_workspace/) was
# incidentally covered -- but nothing stopped one being written to a project
# directory, where it would be tracked.
*.bak
*.backup
*.bak-*
*_backup*
*_backup.*

# Kaggle API token (the CLI also reads ~/.kaggle/kaggle.json, outside the repo)
.kaggle/

# Private keys and credential material, wherever they land
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa
id_rsa.*
id_ed25519*
.netrc
.npmrc
.pypirc
credentials
credentials.*
*secrets*.json
service-account*.json

# ---------------------------------------------------------------------------
# Orchestration state -- machine-local, regenerated on every run
#
# NOTE: `projects/*/.agent/` task boards and review histories are force-added
# (`git add -f`) despite the `.agent/` rule above. They are not machine-local
# state -- they are the evidence of how the agents actually behaved (task
# decomposition, 25 escalations, reviewer verdicts) and are the reason this
# repository is published.
# ---------------------------------------------------------------------------
logs/
.system/
.shared_workspace/
.agent/
pause.flag
# Coding-agent working logs (the operator helper writes these outside the tree
# by default; ignored here so a run that lands inside the repo stays untracked).
runlogs/

# ---------------------------------------------------------------------------
# Publication hygiene (added 2026-10-11)
# ---------------------------------------------------------------------------
# SQLite runtime state. The -shm/-wal sidecars were untracked but unignored, so a
# live run left them in `git status`; the .sqlite3 files are 7.9 MB of append-only
# decision logs that regenerate on demand.
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal

# Re-downloadable market-data cache (~28 MB of OHLCV JSON, rebuilt from yfinance).
projects/*/data/cache/

# Bulk backtest result blobs (regenerated by re-running the sweep; the largest is
# 831 KB of per-grid-day detail). The small aggregate stats files are kept below.
projects/*/data/*backtest_max.json
projects/*/data/backtest_walkforward.json
projects/*/data/volume_gate_sweep*.json

# ---------------------------------------------------------------------------
# Project artifacts
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Bulk data, submissions and model artifacts: re-downloadable, never in git.
# Scoped to the project data dirs -- a small fixture CSV committed on purpose
# under tests/ stays tracked.
projects/*/data/raw/
projects/*/data/processed/
projects/*/submissions/
projects/*/reports/
projects/*/experiments/artifacts/
projects/*/*.parquet
projects/*/*.pkl
projects/*/*.joblib
projects/*/*.h5
projects/*/*.onnx
projects/*/*.pt
*.parquet
*.joblib
*.onnx

# ---------------------------------------------------------------------------
# Environments / editors / OS
# ---------------------------------------------------------------------------
.venv/
venv/
env/
.idea/
.vscode/
.DS_Store
Thumbs.db